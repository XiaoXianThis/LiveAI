# OpenAI 兼容接口。请求发到 ${LLM_BASE_URL}/chat/completions。
# 官方 OpenAI 用下面的默认值；其他服务改 base url、key 和 model 即可。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

DATABASE_URL=file:../data/liveai.db
PORT=3000

# 硅基流动。填了 VOICE_* 后，语音识别和合成走这里，不必再填 STT_* / TTS_*。
VOICE_API_KEY=
VOICE_API_BASE_URL=https://api.siliconflow.cn/v1
VOICE_STT_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra
VOICE_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# 音色可写短名 alex，程序会拼成「模型:alex」再请求。
VOICE_TTS_VOICE=alex
VOICE_TTS_FORMAT=mp3

# 其他供应商仍可用 LiveKit 模型字符串，例如 deepgram/nova-3。与 VOICE_* 二选一。
STT_PROVIDER=
STT_MODEL=
TTS_PROVIDER=
TTS_MODEL=
TURN_DETECTION=vad
